{
  "name": "@dimkatet/hdr-canvas",
  "version": "0.1.9",
  "description": "WebGPU-based HDR image rendering library with native HDR display support and React bindings",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "hdr",
    "webgpu",
    "hdr10",
    "canvas",
    "tone-mapping",
    "display-p3",
    "image-viewer",
    "react"
  ],
  "author": "dimkatet",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dimkatet/hdr-inspector.git",
    "directory": "packages/hdr-image-renderer"
  },
  "homepage": "https://github.com/dimkatet/hdr-inspector#readme",
  "bugs": {
    "url": "https://github.com/dimkatet/hdr-inspector/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.5",
    "@types/throttle-debounce": "^5.0.2",
    "@webgpu/types": "^0.1.68",
    "react": "^19.2.0",
    "tsup": "^8.3.5",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "throttle-debounce": "^5.0.2"
  }
}
