{
  "name": "@dimkatet/hdr-canvas",
  "version": "0.1.0",
  "description": "WebGPU-based HDR image viewer with native HDR display support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "hdr",
    "webgpu",
    "image-viewer",
    "radiance",
    "tone-mapping"
  ],
  "author": "dimkatet",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.5",
    "@webgpu/types": "^0.1.68",
    "react": "^19.2.0",
    "tsup": "^8.3.5",
    "typescript": "~5.9.3"
  }
}
